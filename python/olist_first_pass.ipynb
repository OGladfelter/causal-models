    "print(df.groupby('late').review_score.agg(['mean','count']).round(3))\n",
    "naive = df.loc[df.late==1,'review_score'].mean() - df.loc[df.late==0,'review_score'].mean()\n",
    "print('\\nNaive gap (late - on time):', round(naive, 3))"
