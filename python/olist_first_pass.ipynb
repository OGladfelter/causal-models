  {
   "cell_type": "markdown",
   "id": "3016af6c",
   "metadata": {},
   "source": [
    "## 4. Regression with controls"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "f053bec5",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-23T17:50:54.263205Z",
     "iopub.status.busy": "2026-11-23T17:50:54.262916Z",
     "iopub.status.idle": "2026-11-23T17:50:57.294933Z",
     "shell.execute_reply": "2026-11-23T17:50:57.294103Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "OLS effect of late: -1.708 | 95% CI [-1.746, -1.669]\n"
     ]
    }
   ],
   "source": [
    "top = df.category.value_counts().index[:15]\n",
    "df['cat'] = np.where(df.category.isin(top), df.category, 'other')\n",
    "\n",
    "formula = ('review_score ~ late + est_lead_days + np.log1p(price) + np.log1p(freight) + n_items'\n",
    "           ' + np.log1p(weight) + n_sellers + np.log1p(distance_km) + same_state'\n",
    "           ' + C(cat) + C(customer_state) + C(seller_state) + C(month) + C(year)')\n",
    "ols = smf.ols(formula, df).fit(cov_type='HC1')\n",
    "ols_ci = ols.conf_int().loc['late'].tolist()\n",
    "print('OLS effect of late:', round(ols.params['late'], 3), '| 95% CI', [round(c,3) for c in ols_ci])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "50943e03",
   "metadata": {},
   "source": [
    "## 5. Propensity score, overlap and weighting"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "3eed9b3a",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-23T17:50:57.296700Z",
     "iopub.status.busy": "2026-11-23T17:50:57.296438Z",
     "iopub.status.idle": "2026-11-23T17:51:26.347244Z",
     "shell.execute_reply": "2026-11-23T17:51:26.345858Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Propensity range: 0.001 to 0.825\n",
      "Share of orders with propensity in [0.01, 0.99]: 0.9636\n",
      "Weighted (IPW) effect of late: -1.633\n"
     ]
    }
   ],
   "source": [
    "num = ['est_lead_days','price','freight','n_items','weight','n_sellers','distance_km','same_state']\n",
    "X = pd.concat([df[num],\n",
    "               pd.get_dummies(df[['cat','customer_state','seller_state']], drop_first=True).astype(float),\n",
    "               pd.get_dummies(df[['month','year']].astype(str), drop_first=True).astype(float)], axis=1)\n",
    "Y = df.review_score.values\n",
    "T = df.late.values\n",
    "\n",
    "ps = cross_val_predict(HistGradientBoostingClassifier(max_depth=4, max_iter=150, random_state=0),\n",
    "                       X, T, cv=5, method='predict_proba')[:, 1]\n",
    "print('Propensity range:', ps.min().round(3), 'to', ps.max().round(3))\n",
    "print('Share of orders with propensity in [0.01, 0.99]:', ((ps>0.01)&(ps<0.99)).mean().round(4))\n",
    "\n",
    "ps_c = np.clip(ps, 0.01, 0.99)\n",
    "w = T/ps_c + (1-T)/(1-ps_c)\n",
    "ipw = (np.average(Y[T==1], weights=w[T==1]) - np.average(Y[T==0], weights=w[T==0]))\n",
    "print('Weighted (IPW) effect of late:', round(ipw, 3))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7315eb3d",
   "metadata": {},
   "source": [
    "## 6. Double machine learning (EconML)\n",
    "Gradient boosting for both the outcome and treatment models, 5-fold cross-fitting."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "fcc3d00c",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-23T17:51:26.349693Z",
     "iopub.status.busy": "2026-11-23T17:51:26.349420Z",
     "iopub.status.idle": "2026-11-23T17:52:23.768676Z",
     "shell.execute_reply": "2026-11-23T17:52:23.768225Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "DML effect of late: -1.686 | 95% CI [-1.726, -1.647]\n"
     ]
    }
   ],
   "source": [
    "def fit_dml(treatment, seed=0):\n",
    "    est = LinearDML(model_y=HistGradientBoostingRegressor(max_depth=4, max_iter=150, random_state=seed),\n",
    "                    model_t=HistGradientBoostingClassifier(max_depth=4, max_iter=150, random_state=seed),\n",
    "                    discrete_treatment=True, cv=5, random_state=seed)\n",
    "    est.fit(Y, treatment, X=None, W=X.values)\n",
    "    return est\n",
    "\n",
    "dml = fit_dml(T)\n",
    "dml_ate = float(np.ravel(dml.const_marginal_ate())[0])\n",
    "lo, hi = dml.const_marginal_ate_interval(alpha=0.05)\n",
    "dml_lo, dml_hi = float(np.ravel(lo)[0]), float(np.ravel(hi)[0])\n",
    "print('DML effect of late:', round(dml_ate,3), '| 95% CI', [round(dml_lo,3), round(dml_hi,3)])"
   ]
  },
