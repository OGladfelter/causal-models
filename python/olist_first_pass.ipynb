   "source": [
    "import os, warnings\n",
    "import numpy as np, pandas as pd\n",
    "import statsmodels.formula.api as smf\n",
    "from sklearn.ensemble import HistGradientBoostingRegressor, HistGradientBoostingClassifier\n",
    "from sklearn.model_selection import cross_val_predict\n",
    "from econml.dml import LinearDML\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Folder with the unzipped Olist csv files (change this if yours is somewhere else)\n",
    "DATA_DIR = os.environ.get('OLIST_DIR', 'olist') + '/'"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "aefae088",
   "metadata": {},
   "source": [
    "## 1. Merge the tables\n",
    "One row per delivered order that has a review."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "daad73f8",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-23T17:50:45.055958Z",
     "iopub.status.busy": "2026-11-23T17:50:45.055279Z",
     "iopub.status.idle": "2026-11-23T17:50:54.149696Z",
     "shell.execute_reply": "2026-11-23T17:50:54.148892Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/latex": [
       "$\\displaystyle \\left( 95824, \\  25\\right)$"
      ],
      "text/plain": [
       "(95824, 25)"
      ]
     },
     "execution_count": 2,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "orders = pd.read_csv(DATA_DIR+'olist_orders_dataset.csv',\n",
    "    parse_dates=['order_purchase_timestamp','order_delivered_customer_date','order_estimated_delivery_date'])\n",
    "orders = orders[orders.order_status=='delivered'].dropna(subset=['order_delivered_customer_date'])\n",
    "\n",
    "items   = pd.read_csv(DATA_DIR+'olist_order_items_dataset.csv')\n",
    "prods   = pd.read_csv(DATA_DIR+'olist_products_dataset.csv')\n",
    "trans   = pd.read_csv(DATA_DIR+'product_category_name_translation.csv')\n",
    "reviews = pd.read_csv(DATA_DIR+'olist_order_reviews_dataset.csv')\n",
    "cust    = pd.read_csv(DATA_DIR+'olist_customers_dataset.csv')\n",
    "sellers = pd.read_csv(DATA_DIR+'olist_sellers_dataset.csv')\n",
    "geo = (pd.read_csv(DATA_DIR+'olist_geolocation_dataset.csv')\n",
    "         .groupby('geolocation_zip_code_prefix')[['geolocation_lat','geolocation_lng']].mean())\n",
    "\n",
    "# item level -> order level\n",
    "items = (items.merge(prods,on='product_id',how='left')\n",
    "              .merge(trans,on='product_category_name',how='left')\n",
    "              .merge(sellers,on='seller_id',how='left'))\n",
    "order_items = items.groupby('order_id').agg(\n",
    "    price=('price','sum'), freight=('freight_value','sum'), n_items=('order_item_id','max'),\n",
    "    weight=('product_weight_g','sum'), category=('product_category_name_english','first'),\n",
    "    seller_zip=('seller_zip_code_prefix','first'), seller_state=('seller_state','first'),\n",
    "    n_sellers=('seller_id','nunique')).reset_index()\n",
    "\n",
    "# some orders have more than one review: use the average\n",
    "review_score = reviews.groupby('order_id').review_score.mean().reset_index()\n",
    "\n",
    "df = (orders.merge(order_items,on='order_id')\n",
    "            .merge(review_score,on='order_id')\n",
    "            .merge(cust,on='customer_id'))\n",
    "df = (df.join(geo.add_prefix('c_'), on='customer_zip_code_prefix')\n",
    "        .join(geo.add_prefix('s_'), on='seller_zip'))\n",
    "df.shape"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "554d4741",
   "metadata": {},
   "source": [
    "## 2. Build treatment, outcome and confounders"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "cdbdd0ae",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-23T17:50:54.152436Z",
     "iopub.status.busy": "2026-11-23T17:50:54.152084Z",
     "iopub.status.idle": "2026-11-23T17:50:54.224790Z",
     "shell.execute_reply": "2026-11-23T17:50:54.223377Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Orders in the analysis: 94010\n",
      "Share late: 0.0797 | late orders: 7494\n"
     ]
    }
   ],
   "source": [
    "def haversine(lat1, lon1, lat2, lon2):\n",
    "    lat1, lon1, lat2, lon2 = map(np.radians, [lat1, lon1, lat2, lon2])\n",
    "    a = np.sin((lat2-lat1)/2)**2 + np.cos(lat1)*np.cos(lat2)*np.sin((lon2-lon1)/2)**2\n",
    "    return 6371*2*np.arcsin(np.sqrt(a))\n",
    "\n",
    "df['distance_km'] = haversine(df.c_geolocation_lat, df.c_geolocation_lng,\n",
    "                              df.s_geolocation_lat, df.s_geolocation_lng)\n",
    "df['late'] = (df.order_delivered_customer_date > df.order_estimated_delivery_date).astype(int)\n",
    "df['est_lead_days'] = (df.order_estimated_delivery_date - df.order_purchase_timestamp).dt.total_seconds()/86400\n",
    "df['month'] = df.order_purchase_timestamp.dt.month\n",
    "df['year']  = df.order_purchase_timestamp.dt.year\n",
    "df['same_state'] = (df.customer_state == df.seller_state).astype(int)\n",
    "\n",
    "keep = ['review_score','late','est_lead_days','price','freight','n_items','weight','n_sellers',\n",
    "        'distance_km','same_state','month','year','category','customer_state','seller_state']\n",
    "df = (df[keep].dropna(subset=['review_score','price','freight','weight','distance_km','category'])\n",
    "              .reset_index(drop=True))\n",
    "print('Orders in the analysis:', len(df))\n",
    "print('Share late:', round(df.late.mean(), 4), '| late orders:', int(df.late.sum()))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fe5bf8bb",
   "metadata": {},
   "source": [
